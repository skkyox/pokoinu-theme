{% comment %}
  Fondation de marque Pokoinu : polices Google (Quicksand + Nunito) et tokens CSS.
  Rendu dans le <head> de theme.liquid, après color-palette, pour que la marque
  soit disponible partout via les variables --poko-*.
{% endcomment %}
{% # theme-check-disable RemoteAsset %}
{% comment %} Polices Google acceptées ici (rendu exact de la maquette). Optim possible plus tard : servir via CDN Shopify. {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700&family=Nunito:wght@400;600;700&display=swap"
>
{% # theme-check-enable RemoteAsset %}
{{ 'pokoinu.css' | asset_url | stylesheet_tag }}

{% comment %} Quiet Sans — police de la maquette (landing page). Auto-hébergée. {% endcomment %}
<style>
  @font-face {
    font-family: "Quiet Sans";
    src: url({{ 'QuietSans-Regular.otf' | asset_url }}) format("opentype");
    font-weight: 400; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Quiet Sans";
    src: url({{ 'QuietSans-Italic.otf' | asset_url }}) format("opentype");
    font-weight: 400; font-style: italic; font-display: swap;
  }
  @font-face {
    font-family: "Quiet Sans";
    src: url({{ 'QuietSans-SemiBold.otf' | asset_url }}) format("opentype");
    font-weight: 600; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Quiet Sans";
    src: url({{ 'QuietSans-Bold.otf' | asset_url }}) format("opentype");
    font-weight: 700; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: "Quiet Sans";
    src: url({{ 'QuietSans-BoldItalic.otf' | asset_url }}) format("opentype");
    font-weight: 700; font-style: italic; font-display: swap;
  }
  @font-face {
    font-family: "Quiet Sans";
    src: url({{ 'QuietSans-ExtraBold.otf' | asset_url }}) format("opentype");
    font-weight: 800; font-style: normal; font-display: swap;
  }
</style>
{{ 'pokoinu-lp.css' | asset_url | stylesheet_tag }}
