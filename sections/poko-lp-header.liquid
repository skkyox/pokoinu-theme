{%- liquid
  assign sticky = section.settings.sticky
-%}
<header class="lp lp-header{% if sticky %} lp-header--sticky{% endif %}" style="--lp-h-bg: {{ section.settings.background_color }};">
  <div class="lp-container lp-container--wide lp-header__bar">
    <a class="lp-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 320 }}"
          alt="{{ shop.name | escape }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          style="height: {{ section.settings.logo_height }}px; width: auto;"
        >
      {%- else -%}
        <span class="lp-header__paw" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7.5 11.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm9 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM5.2 15.6a1.9 1.9 0 1 0-1.4-2.3 1.9 1.9 0 0 0 1.4 2.3Zm13.6 0a1.9 1.9 0 1 0-1.4-2.3 1.9 1.9 0 0 0 1.4 2.3ZM12 13c-2.3 0-4.2 1.8-4.7 3.6-.4 1.5.8 2.7 2.3 2.4.8-.2 1.6-.3 2.4-.3s1.6.1 2.4.3c1.5.3 2.7-.9 2.3-2.4C16.2 14.8 14.3 13 12 13Z"/></svg>
        </span>
        <span class="lp-header__name">{{ section.settings.logo_text | default: shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="lp-header__nav" aria-label="Menu principal">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_link' -%}
          <a class="lp-header__link" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
            {%- if block.settings.icon == 'harness' -%}
              <svg class="lp-header__linkicon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 5h12l-2.2 6.5a4 4 0 0 1-3.8 2.7 4 4 0 0 1-3.8-2.7L6 5Z" fill="currentColor" opacity=".18"/>
                <path d="M6 5h12l-2.2 6.5a4 4 0 0 1-3.8 2.7 4 4 0 0 1-3.8-2.7L6 5Zm6 9.2V19m-3 0h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endif -%}
            <span>{{ block.settings.label }}</span>
            {%- if block.settings.caret -%}
              <svg class="lp-header__caret" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="lp-header__actions">
      <a class="lp-header__action" href="{{ routes.search_url }}" aria-label="Rechercher">
        <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="M20 20l-3.6-3.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </a>
      <a class="lp-header__action" href="{{ routes.account_url }}" aria-label="Compte">
        <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8.5" r="3.7" stroke="currentColor" stroke-width="1.8"/><path d="M5 20c.7-3.6 3.6-5.5 7-5.5s6.3 1.9 7 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </a>
      <a class="lp-header__action lp-header__cart" href="{{ routes.cart_url }}" aria-label="Panier">
        <svg viewBox="0 0 24 24" fill="none"><path d="M6 8h12l-1 11a1 1 0 0 1-1 .9H8a1 1 0 0 1-1-.9L6 8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <span class="lp-header__badge" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .lp-header {
    background: var(--lp-h-bg, #F9F9F9);
    border-bottom: 1px solid var(--lp-border);
  }
  .lp-header--sticky { position: sticky; top: 0; z-index: 50; }
  .lp-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
  }
  .lp-header__logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    flex: none;
  }
  .lp-header__paw { display: inline-flex; color: var(--lp-coral); }
  .lp-header__paw svg { width: 26px; height: 26px; }
  .lp-header__name {
    font-size: 24px;
    font-weight: 800;
    color: var(--lp-coral);
    letter-spacing: -0.01em;
  }
  .lp-header__nav {
    display: none;
    align-items: center;
    gap: 34px;
  }
  .lp-header__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 16px;
    font-weight: 600;
    color: var(--lp-ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .lp-header__link:hover { color: var(--lp-coral); }
  .lp-header__linkicon { width: 19px; height: 19px; color: var(--lp-coral); flex: none; }
  .lp-header__caret { width: 15px; height: 15px; opacity: .7; }
  .lp-header__actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: none;
  }
  .lp-header__action {
    display: inline-flex;
    position: relative;
    color: var(--lp-ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .lp-header__action:hover { color: var(--lp-coral); }
  .lp-header__action svg { width: 22px; height: 22px; }
  .lp-header__badge {
    position: absolute;
    top: -7px;
    right: -8px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--lp-coral);
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
    line-height: 17px;
    text-align: center;
  }
  @media (min-width: 1000px) {
    .lp-header__nav { display: flex; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Poko LP — En-tête",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo (image)" },
    { "type": "text", "id": "logo_text", "label": "Logo (texte)", "default": "Poko Inu" },
    { "type": "range", "id": "logo_height", "min": 20, "max": 60, "step": 2, "unit": "px", "label": "Hauteur du logo image", "default": 34 },
    { "type": "header", "content": "Comportement" },
    { "type": "checkbox", "id": "sticky", "label": "En-tête collant", "default": true },
    { "type": "color", "id": "background_color", "label": "Fond", "default": "#F9F9F9" }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Lien de menu",
      "settings": [
        { "type": "text", "id": "label", "label": "Libellé", "default": "Lien" },
        { "type": "url", "id": "url", "label": "Lien" },
        { "type": "select", "id": "icon", "label": "Icône", "default": "none", "options": [
          { "value": "none", "label": "Aucune" },
          { "value": "harness", "label": "Harnais" }
        ] },
        { "type": "checkbox", "id": "caret", "label": "Chevron (sous-menu)", "default": false }
      ]
    }
  ],
  "presets": [{
    "name": "Poko LP — En-tête",
    "blocks": [
      { "type": "nav_link", "settings": { "label": "Nos produits", "url": "/collections/all" } },
      { "type": "nav_link", "settings": { "label": "Harnais", "icon": "harness", "caret": true } },
      { "type": "nav_link", "settings": { "label": "Jouets" } },
      { "type": "nav_link", "settings": { "label": "Paniers" } }
    ]
  }]
}
{% endschema %}
