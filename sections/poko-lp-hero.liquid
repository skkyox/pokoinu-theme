{%- liquid
  assign rating = section.settings.rating | times: 1.0
  assign full = rating | floor
  assign half = rating | minus: full
  assign next = full | plus: 1
-%}
<section class="lp lp-hero">
  <div class="lp-container lp-hero__inner">
    <div class="lp-hero__grid">
      <div class="lp-hero__media">
        {%- if section.settings.image != blank -%}
          <img class="lp-img lp-hero__img" src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="eager">
        {%- else -%}
          <div class="lp-ph lp-hero__img">{{ section.settings.image_caption }}</div>
        {%- endif -%}
      </div>

      <div class="lp-hero__content">
        <div class="lp-hero__rating">
          <div class="lp-hero__avatars">
            {%- for i in (1..4) -%}
              {%- assign key = 'avatar_' | append: i -%}
              {%- assign av = section.settings[key] -%}
              <span class="lp-hero__avatar lp-hero__avatar--{{ i }}">
                {%- if av != blank -%}
                  <img class="lp-img" src="{{ av | image_url: width: 96 }}" alt="" width="{{ av.width }}" height="{{ av.height }}" loading="eager">
                {%- endif -%}
              </span>
            {%- endfor -%}
          </div>
          <div class="lp-hero__ratingtext">
            <span class="lp-hero__ratingnum">{{ section.settings.rating_label }}</span>
            <span class="lp-stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                {%- if i <= full -%}
                  <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 15l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8L10 1.6Z"/></svg>
                {%- elsif half > 0 and i == next -%}
                  <svg viewBox="0 0 20 20"><defs><linearGradient id="lp-half-{{ section.id }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="#E4E0DA"/></linearGradient></defs><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 15l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8L10 1.6Z" fill="url(#lp-half-{{ section.id }})"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 20 20" fill="#E4E0DA"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 15l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8L10 1.6Z"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </span>
          </div>
        </div>

        <h1 class="lp-h lp-hero__title">{{ section.settings.heading }}</h1>

        {%- if section.settings.subheading != blank -%}
          <div class="lp-hero__lead lp-lead">{{ section.settings.subheading }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="lp-btn lp-hero__cta" href="{{ section.settings.button_link | default: '#' }}">
            <svg class="lp-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.5 11.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm9 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM5.2 15.6a1.9 1.9 0 1 0-1.4-2.3 1.9 1.9 0 0 0 1.4 2.3Zm13.6 0a1.9 1.9 0 1 0-1.4-2.3 1.9 1.9 0 0 0 1.4 2.3ZM12 13c-2.3 0-4.2 1.8-4.7 3.6-.4 1.5.8 2.7 2.3 2.4.8-.2 1.6-.3 2.4-.3s1.6.1 2.4.3c1.5.3 2.7-.9 2.3-2.4C16.2 14.8 14.3 13 12 13Z"/></svg>
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="lp-hero__chips">
        {%- for block in section.blocks -%}
          <div class="lp-chip" {{ block.shopify_attributes }}>
            <span class="lp-chip__icon">
              {%- case block.settings.icon -%}
                {%- when 'pull' -%}
                  <svg viewBox="0 0 24 24" fill="none"><path d="M4 12h6m4 0h6M9 8l-4 4 4 4m6-8l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'choke' -%}
                  <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v4m0 0a5 5 0 0 0-5 5v3a5 5 0 0 0 10 0v-3a5 5 0 0 0-5-5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'airtag' -%}
                  <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="1.7"/><path d="M12 13c-4 0-6 2.5-6 5.5V20h12v-1.5c0-3-2-5.5-6-5.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="12" cy="10" r="7.5" stroke="currentColor" stroke-width="1.2" opacity=".4"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </span>
            <div class="lp-chip__body">
              <p class="lp-chip__title">{{ block.settings.title }}</p>
              <p class="lp-chip__text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .lp-hero { background: var(--lp-bg); }
  .lp-hero__inner { padding-block: 40px 44px; }
  .lp-hero__grid { display: grid; gap: 28px; }
  .lp-hero__img { border-radius: var(--lp-radius-img); aspect-ratio: 5 / 6; }
  .lp-hero__content { display: flex; flex-direction: column; align-items: flex-start; }

  .lp-hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--lp-grey);
    border-radius: var(--lp-radius-pill);
    padding: 8px 18px 8px 10px;
    margin-bottom: 22px;
  }
  .lp-hero__avatars { display: flex; }
  .lp-hero__avatar {
    width: 34px; height: 34px; border-radius: 999px;
    border: 2px solid var(--lp-grey);
    background: #D9D2C8; overflow: hidden; margin-left: -10px;
    display: inline-block;
  }
  .lp-hero__avatar--1 { margin-left: 0; }
  .lp-hero__ratingtext { display: flex; flex-direction: column; gap: 3px; }
  .lp-hero__ratingnum { font-size: 13.5px; font-weight: 700; color: var(--lp-ink); }
  .lp-hero__rating .lp-stars svg { width: 14px; height: 14px; }

  .lp-hero__title { font-size: 40px; line-height: 1.16; }
  .lp-hero__title em { color: var(--lp-coral); font-style: italic; }
  .lp-hero__lead { margin: 20px 0 26px; max-width: 42ch; font-size: 16px; }
  .lp-hero__lead em { color: var(--lp-ink); font-weight: 600; font-style: italic; }
  .lp-hero__cta { align-self: stretch; }

  .lp-hero__chips { display: grid; gap: 14px; margin-top: 34px; }
  .lp-chip {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: var(--lp-grey);
    border-radius: var(--lp-radius-chip);
    padding: 18px 20px;
  }
  .lp-chip__icon {
    flex: none;
    width: 40px; height: 40px;
    display: grid; place-items: center;
    border-radius: 999px;
    background: var(--lp-white);
    border: 1.5px solid var(--lp-coral);
    color: var(--lp-coral);
  }
  .lp-chip__icon svg { width: 21px; height: 21px; }
  .lp-chip__title { margin: 2px 0 5px; font-size: 15px; font-weight: 700; color: var(--lp-ink); }
  .lp-chip__text { margin: 0; font-size: 12.5px; line-height: 1.55; color: var(--lp-body); }

  @media (min-width: 1000px) {
    .lp-hero__inner { padding-block: 52px 58px; }
    .lp-hero__grid { grid-template-columns: 0.62fr 1fr; gap: 48px; align-items: center; }
    .lp-hero__img { aspect-ratio: 7 / 8; }
    .lp-hero__title { font-size: 64px; line-height: 1.08; }
    .lp-hero__cta { align-self: flex-start; }
    .lp-hero__chips { grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 44px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Poko LP — Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image principale" },
    { "type": "text", "id": "image_caption", "label": "Légende placeholder", "default": "photo — chien au harnais" },
    { "type": "header", "content": "Notation" },
    { "type": "image_picker", "id": "avatar_1", "label": "Avatar 1" },
    { "type": "image_picker", "id": "avatar_2", "label": "Avatar 2" },
    { "type": "image_picker", "id": "avatar_3", "label": "Avatar 3" },
    { "type": "image_picker", "id": "avatar_4", "label": "Avatar 4" },
    { "type": "text", "id": "rating_label", "label": "Texte notation", "default": "4,5 notés par vous" },
    { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 0.5, "label": "Nombre d'étoiles", "default": 4.5 },
    { "type": "header", "content": "Contenu" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Le <em>harnais</em> pensé pour des promenades plus <em>sereines</em>" },
    { "type": "richtext", "id": "subheading", "label": "Sous-titre", "default": "<p>Le harnais <em>anti-traction</em> avec emplacement intégré pour <em>AirTag</em>, conçu pour vous offrir une tranquillité d'esprit supplémentaire à chaque <em>promenade</em>.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton — texte", "default": "Découvrez nos harnais SafeTrack™" },
    { "type": "url", "id": "button_link", "label": "Bouton — lien" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Argument",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "pull", "options": [
          { "value": "pull", "label": "Anti-traction" },
          { "value": "choke", "label": "Anti-étouffement" },
          { "value": "airtag", "label": "AirTag" },
          { "value": "check", "label": "Coche" }
        ] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Argument" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Description courte de l'argument." }
      ]
    }
  ],
  "presets": [{
    "name": "Poko LP — Hero",
    "blocks": [
      { "type": "chip", "settings": { "icon": "pull", "title": "Anti-traction", "text": "Une conception pensée pour limiter les tiraillements et vous offrir un meilleur contrôle." } },
      { "type": "chip", "settings": { "icon": "choke", "title": "Anti-étouffement", "text": "Contrairement à un collier, le harnais répartit la traction sur le corps pour réduire la pression sur le cou." } },
      { "type": "chip", "settings": { "icon": "airtag", "title": "AirTag Ready", "text": "Un emplacement spécialement conçu pour ajouter un AirTag afin de faciliter la localisation de votre compagnon." } }
    ]
  }]
}
{% endschema %}
